{
  "name": "nexar-transcan",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.10.0",
    "jspdf": "^4.2.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.14.0",
    "react-scripts": "5.0.1",
    "react-select": "^5.10.2",
    "sweetalert2": "^11.26.24",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "start:emulator": "cross-env REACT_APP_USE_FIREBASE_EMULATOR=true BROWSER=none HOST=127.0.0.1 PORT=3001 react-scripts start",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-nexar-transcan",
    "dev:emulator": "concurrently --kill-others-on-fail --names EMULATORS,REACT \"npm:emulators\" \"npm:start:emulator\"",
    "seed:emulator": "node scripts/emulator/seed.js",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "firebase-tools": "^15.29.0"
  }
}
